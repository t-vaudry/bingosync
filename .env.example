# =============================================================================
# BingoSync (HP CoS) - production configuration for docker-compose.yml
# =============================================================================
# Copy this file to .env next to docker-compose.yml and fill it in.
# Never commit .env to version control.
#
# Generate each secret below with:   openssl rand -hex 32
# (Hex output is safe inside the database URL; avoid @ : / in DB_PASSWORD.)

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------
# Public hostname players use, without https:// or a trailing slash.
# Your reverse proxy (e.g. Nginx Proxy Manager) must forward this hostname.
DOMAIN=bingo.example.com

# Host port the stack listens on. Point your reverse proxy at
# http://<server-ip>:<HTTP_PORT>. Avoid 80/443 on Unraid (its web UI uses them).
HTTP_PORT=8088

# PostgreSQL credentials. With the bundled database these are created on
# first start; with your own server, use the user and password you created.
DB_USER=bingosync
DB_PASSWORD=

# Database: bundled (default) or your own.
#
# Bundled: keep this line. Postgres runs in the stack and stores its files in
# ./postgres-data next to docker-compose.yml (on Unraid:
# /mnt/user/appdata/bingosync/postgres-data). Set POSTGRES_DATA_DIR to put
# them elsewhere.
COMPOSE_PROFILES=bundled-db
# POSTGRES_DATA_DIR=./postgres-data
#
# Your own Postgres server: delete the COMPOSE_PROFILES line above and set
# where to connect. On Unraid, use the server's LAN IP and the port your
# Postgres container publishes.
# DB_HOST=192.168.1.10
# DB_PORT=5432
# DB_NAME=bingosync

# Django secret key.
DJANGO_SECRET_KEY=

# Shared secret between Django and the websocket server (32+ characters).
INTERNAL_API_SECRET=

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------
# Must stay 0 in production.
DEBUG=0

# DEBUG, INFO, WARNING, ERROR, CRITICAL
DJANGO_LOG_LEVEL=INFO

# Sentry error reporting; leave empty to disable.
SENTRY_DSN=

# SMTP for password-reset emails. Leave EMAIL_HOST empty to skip email:
# reset links are then written to the bingosync-django container log.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
